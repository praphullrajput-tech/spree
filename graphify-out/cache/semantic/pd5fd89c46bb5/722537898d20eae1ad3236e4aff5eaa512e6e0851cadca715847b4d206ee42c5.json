{"nodes": [{"id": "docs_api_reference_store_api_migrating_from_storefront_api_v2", "label": "Migrating from Storefront API v2", "file_type": "document", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_reference_storefront_v2", "label": "Storefront API v2", "file_type": "concept", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_reference_store_api_v3", "label": "Store API v3", "file_type": "concept", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_reference_admin_api", "label": "Admin API", "file_type": "concept", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spree_legacy_api_v2_gem", "label": "spree_legacy_api_v2 gem", "file_type": "concept", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_markets", "label": "Markets", "file_type": "concept", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_pricing_engine", "label": "New Pricing Engine", "file_type": "concept", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_json_api_format", "label": "JSON:API Format", "file_type": "rationale", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON:API's sparse fieldsets and normalized payloads were real strengths, but most storefront clients flattened the response anyway, causing a noisy wire format and two-step deserialization; v3 drops it for flat JSON with expand-based association inlining."}, {"id": "concept_flat_json_response", "label": "Flat JSON Response Format", "file_type": "rationale", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns resources directly with associations inlined via expand, avoiding the noisy wire format and two-step deserialization JSON:API required."}, {"id": "concept_prefixed_ids", "label": "Prefixed IDs (Stripe-style)", "file_type": "concept", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_checkout_state_machine", "label": "Checkout State Machine (v2)", "file_type": "rationale", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The five-step checkout state machine made cart/checkout calls easy to write but hard to reason about, since the same payload could land in different states depending on the current step; v3 removes it entirely."}, {"id": "concept_cart_resource_v3", "label": "Cart as Explicit REST Resource", "file_type": "rationale", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collapsing checkout into the cart resource (stable prefixed ID, nested fulfillments/payments) removes step transitions and implicit current-cart state, enabling Shopify-style one-page checkout and multiple saved carts per customer/organization."}, {"id": "package_spree_storefront_api_v2_sdk", "label": "@spree/storefront-api-v2-sdk", "file_type": "code", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "package_spree_sdk", "label": "@spree/sdk", "file_type": "code", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spree_sdk_createclient", "label": "createClient() factory", "file_type": "code", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spree_storefront_api_v2_sdk_makeclient", "label": "makeClient() factory", "file_type": "code", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_publishable_key", "label": "Publishable API Key (pk_xxx)", "file_type": "rationale", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Introduced because Storefront API v2 had no API key concept, so v3 requires one on every request to identify the target store and enable multi-store on a single domain, per-key rate limits, scopes and audit trails."}, {"id": "concept_spreeerror", "label": "SpreeError class", "file_type": "code", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_result_wrapper_v2", "label": "Result<Error, Response> wrapper (v2)", "file_type": "concept", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_zod_schemas", "label": "Zod Runtime Schemas", "file_type": "concept", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_payment_sessions_api", "label": "Payment Sessions API", "file_type": "rationale", "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unifies per-gateway endpoints (Stripe, Adyen, PayPal) behind a generic API so Spree dispatches to the right provider based on payment_method_id, shortening integration time and avoiding frontend code changes per gateway."}], "edges": [{"source": "docs_api_reference_store_api_v3", "target": "docs_api_reference_storefront_v2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_api_reference_storefront_v2", "target": "spree_legacy_api_v2_gem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api-reference/store-api/migrating-from-storefront-api-v2.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_api_reference_store_api_v3", "target