{"nodes": [{"id": "docs_plans_6_0_admin_spa", "label": "Admin SPA (6.0)", "file_type": "document", "source_file": "docs/plans/6.0-admin-spa.md", "source_location": null, "source_url": null, "captured_at": null, "author": "damian", "contributor": null}, {"id": "docs_plans_6_0_admin_spa_package_split", "label": "dashboard / dashboard-core / dashboard-ui package split", "file_type": "concept", "source_file": "docs/plans/6.0-admin-spa.md", "source_location": null, "source_url": null, "captured_at": null, "author": "damian", "contributor": null, "rationale": "Matches the 3/3 industry pattern (Medusa, Vendure, Saleor) of UI-primitives + extension-SDK + app; goes further by making dashboard-ui carry both primitives and headless composed components, unlike any competitor."}, {"id": "docs_plans_6_0_admin_spa_slot_registry", "label": "Slot registry / <Slot> API", "file_type": "concept", "source_file": "docs/plans/6.0-admin-spa.md", "source_location": null, "source_url": null, "captured_at": null, "author": "damian", "contributor": null, "rationale": "Mirrors the Rails admin's render_admin_partials slot mechanism so plugin authors carry their mental model across; named slots chosen over render-prop overrides because they're append-only and composable."}, {"id": "docs_plans_6_0_admin_spa_table_registry", "label": "Table registry (defineTable)", "file_type": "concept", "source_file": "docs/plans/6.0-admin-spa.md", "source_location": null, "source_url": null, "captured_at": null, "author": "damian", "contributor": null, "rationale": "Declarative resource list page definition mirroring Rails admin's Spree.admin.tables DSL."}, {"id": "docs_plans_6_0_admin_spa_no_spreefield_wrapper", "label": "No <SpreeField>/<SpreeForm> wrapper decision", "file_type": "rationale", "source_file": "docs/plans/6.0-admin-spa.md", "source_location": null, "source_url": null, "captured_at": null, "author": "damian", "contributor": null, "rationale": "A Rails-FormBuilder-equivalent wrapper was tried and r